<?xml version="1.0" encoding="UTF-8"?>
<!--
  AstroDL - PixInsight repository manifest.

  fileName / sha1 / releaseDate are rewritten automatically by
  .github/workflows/release.yml every time a tag (vX.Y.Z) is pushed.
  Title and descriptions are edited by hand when the version changes.

  This manifest is NOT cryptographically signed. PixInsight will show
  an "untrusted repository" warning during install; users may continue
  past it.
-->
<xri version="1.0">
   <description>
      <p><b>AstroDL Suite</b> &mdash; astrophotography tools for
      PixInsight by Luis Jose DL.</p>
      <p>Currently includes <b>Star Recompose Pro</b>: recombines a
      stretched starless image with a linear stars-only image and
      produces a single combined output. Built for the
      StarXTerminator / StarNet++ workflow where the starless half is
      stretched creatively while the stars half is hard to stretch
      without blowing out the bright star cores.</p>
      <p><b>Highlights</b></p>
      <ul>
         <li>Live embedded preview with mouse-wheel zoom and Pan-tool
             drag. Loads either layer first and composites
             automatically once both views are selected.</li>
         <li>Per-channel rational stretch on the stars layer driven
             by a single intensity slider, plus an independent Color
             Boost saturation control that preserves color in bright
             star cores instead of crushing them to white.</li>
         <li>Optional SCNR Green and / or SCNR Magenta passes on the
             stars layer to clean up residual color casts.</li>
         <li>Optional editable <b>ellipse mask</b> to limit the stars
             stretch to a region (e.g. only outside a galaxy or
             nebula core). Click and drag to place, corner handles to
             resize, green handle to rotate. The shape stays anchored
             across window resizes; the cursor changes to a crosshair
             over empty preview area, to a pointing hand over corner
             handles, and to a rotation arrow over the green handle.</li>
         <li>Configurable <b>Mask Strength</b>, <b>Feather</b> (soft
             outer edge as % of image width) and <b>Gradient</b>
             (solid mask=1 core radius). The dashed inner core
             outline is rendered as a true offset curve and shrinks
             smoothly across the full slider range.</li>
         <li><b>Invert</b> mode keeps stars only inside the ellipse
             and removes them everywhere else (outline shows in cyan
             in this mode).</li>
         <li>Three preview modes &mdash; Image only, Image + mask
             effect (matches what Apply will produce), or Mask only
             in black &amp; white &mdash; plus a one-click
             <b>Compare</b> button to flip between with / without
             the mask applied.</li>
         <li><b>Apply</b> runs the full pipeline at the source views'
             native resolution and creates a Combined image. An
             optional second output keeps the stretched stars on
             their own as a separate image, useful as a layer in
             Photoshop or GIMP.</li>
         <li>Drag the blue <b>New Instance</b> triangle (bottom-left
             of the dialog) to the PixInsight workspace to save the
             current slider values as a process icon. Re-open later
             with a double-click for one-click reuse on future
             images.</li>
      </ul>
      <p>MIT License. Free for personal and commercial use.</p>
   </description>
   <platform os="all" arch="noarch" version="1.8.8:1.9.3">
      <package fileName="pkg/AstroDL-StarRecompose-1.2.1.tar.gz"
               sha1="0000000000000000000000000000000000000000"
               type="script"
               releaseDate="20260516">
         <title>Star Recompose Pro</title>
         <description>
            <p><b>Star Recompose Pro v1.2.0</b> &mdash; first stable
            release.</p>
            <p>Recomposes a stretched starless image with a linear
            stars-only image and produces a single combined output,
            previewing the result in real time as you tune the
            controls.</p>
            <p><b>Features</b></p>
            <ul>
               <li>Live embedded preview. Mouse-wheel zoom, click-drag
                   pan with the Pan tool, custom cursors for every
                   editing action.</li>
               <li>Loads either layer first and previews it immediately;
                   composites automatically once both views are
                   selected.</li>
               <li>Single intensity slider for the stars stretch plus
                   an independent color-saturation boost.</li>
               <li>Optional SCNR Green and / or SCNR Magenta on the
                   stars layer to clean up residual color casts.</li>
               <li>Optional ellipse mask to limit the stars stretch to
                   a region (e.g. only outside a galaxy or nebula
                   core). Click and drag to place; drag the corner
                   handles to resize; drag the green handle to rotate.
                   The shape stays anchored across window resizes.</li>
               <li>Configurable mask strength, soft-edge feather, and
                   gradient-core radius. The inner core curve shrinks
                   smoothly across the full slider range without ever
                   self-intersecting, even on highly elongated
                   ellipses.</li>
               <li>Invert mode keeps stars only inside the ellipse and
                   removes them everywhere else (outline shows in cyan
                   in this mode).</li>
               <li>Three preview modes: image only, image with mask
                   effect (matches what Apply will produce), or mask
                   alone in black and white.</li>
               <li>One-click Compare button to flip between with /
                   without the mask applied.</li>
               <li>Optional second output: the stretched stars layer
                   on its own, useful as a separate layer in Photoshop
                   or GIMP.</li>
               <li>Drag the New Instance triangle (bottom-left) to the
                   workspace to save the current slider values as a
                   process icon for one-click reuse on future images.</li>
            </ul>
            <p>MIT License. Free for personal and commercial use.</p>
         </description>
      </package>
   </platform>
</xri>
