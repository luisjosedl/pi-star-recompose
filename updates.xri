<?xml version="1.0" encoding="UTF-8"?>
<!--
  AstroDL - PixInsight repository manifest.

  fileName / sha1 / releaseDate are rewritten automatically by
  .github/workflows/release.yml every time a tag (vX.Y.Z) is pushed.
  Title and descriptions are edited by hand when the version changes.

  This manifest is NOT cryptographically signed. PixInsight will show
  an "untrusted repository" warning during install; users may continue
  past it.
-->
<xri version="1.0">
   <description>
      <p><b>AstroDL Suite</b> &mdash; astrophotography tools for PixInsight
      by Luis Jose DL.</p>
      <p>Currently includes <b>Star Recompose Pro</b>: recombine a
      stretched starless image with a linear stars-only image, with a
      live preview and an optional editable ellipse mask to limit the
      stars stretch to a region.</p>
      <p>Source: <a href="https://github.com/luisjosedl/pi-star-recompose">github.com/luisjosedl/pi-star-recompose</a></p>
   </description>
   <platform os="all" arch="noarch" version="1.8.8:1.9.3">
      <package fileName="pkg/AstroDL-StarRecompose-1.2.0.tar.gz"
               sha1="0000000000000000000000000000000000000000"
               type="script"
               releaseDate="20260516">
         <title>Star Recompose Pro</title>
         <description>
            <p><b>Star Recompose Pro v1.2.0</b> &mdash; first stable
            release.</p>
            <p>Recomposes a stretched starless image with a linear
            stars-only image and produces a single combined output,
            previewing the result in real time as you tune the
            controls.</p>
            <p><b>Features</b></p>
            <ul>
               <li>Live embedded preview. Mouse-wheel zoom, click-drag
                   pan with the Pan tool, custom cursors for every
                   editing action.</li>
               <li>Loads either layer first and previews it immediately;
                   composites automatically once both views are
                   selected.</li>
               <li>Single intensity slider for the stars stretch plus
                   an independent color-saturation boost.</li>
               <li>Optional SCNR Green and / or SCNR Magenta on the
                   stars layer to clean up residual color casts.</li>
               <li>Optional ellipse mask to limit the stars stretch to
                   a region (e.g. only outside a galaxy or nebula
                   core). Click and drag to place; drag the corner
                   handles to resize; drag the green handle to rotate.
                   The shape stays anchored across window resizes.</li>
               <li>Configurable mask strength, soft-edge feather, and
                   gradient-core radius. The inner core curve shrinks
                   smoothly across the full slider range without ever
                   self-intersecting, even on highly elongated
                   ellipses.</li>
               <li>Invert mode keeps stars only inside the ellipse and
                   removes them everywhere else (outline shows in cyan
                   in this mode).</li>
               <li>Three preview modes: image only, image with mask
                   effect (matches what Apply will produce), or mask
                   alone in black and white.</li>
               <li>One-click Compare button to flip between with /
                   without the mask applied.</li>
               <li>Optional second output: the stretched stars layer
                   on its own, useful as a separate layer in Photoshop
                   or GIMP.</li>
               <li>Drag the New Instance triangle (bottom-left) to the
                   workspace to save the current slider values as a
                   process icon for one-click reuse on future images.</li>
            </ul>
            <p>MIT License. Free for personal and commercial use.</p>
         </description>
      </package>
   </platform>
</xri>
